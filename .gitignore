# -----------------------------------------------------------------------------
# Build output (CMake / native runtime)
# -----------------------------------------------------------------------------
/build/
/out/
/bin/
/lib/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json
/CTestTestfile.cmake
/Testing/
/install_manifest.txt
/packages/

# Compiler, linker, and crash output
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.exp
*.pdb
*.idb
*.ilk
*.dmp
*.stackdump

# -----------------------------------------------------------------------------
# Visual Studio and editor-local state
# -----------------------------------------------------------------------------
/.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.vcxproj.user
*.opensdf
*.sdf
*.ncb
*.ipch
*.opendb

# CMake user-specific presets must not override the shared presets.
/CMakeUserPresets.json
/CMakeSettings.json

# -----------------------------------------------------------------------------
# Browser chart/theme editor output
# -----------------------------------------------------------------------------
**/node_modules/
**/.vite/
**/.next/
**/.cache/
**/coverage/
**/dist/
**/storybook-static/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Generated gameplay data, recordings, and local assets
# -----------------------------------------------------------------------------
# Source charts/themes and intentionally small example assets are versioned.
# Generated compiled charts and local/private media are not.
/assets/generated/
/assets/local/
/assets/private/
/themes/local/
/recordings/
/screenshots/local/
/test-results/
/playwright-report/

# -----------------------------------------------------------------------------
# Secrets and machine-local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
secrets/

# -----------------------------------------------------------------------------
# Operating system metadata
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
